 static QList<OBSProjector *> multiviewProjectors;
 
+/* LinTO Live: some window managers (GNOME/Mutter through XWayland) keep the title bar on a projector
+ * made full screen after it was shown as a window. A full-screen projector drops its frame; a windowed
+ * one gets it back. setWindowFlags hides the window: the caller shows it again. */
+static void SetProjectorFrameless(QWidget *window, bool frameless)
+{
+#if defined(__linux__) || defined(__FreeBSD__) || defined(__DragonFly__)
+	Qt::WindowFlags flags = window->windowFlags();
+	if (flags.testFlag(Qt::FramelessWindowHint) == frameless)
+		return;
+	window->setWindowFlags(flags.setFlag(Qt::FramelessWindowHint, frameless));
+#else
+	Q_UNUSED(window);
+	Q_UNUSED(frameless);
+#endif
+}
+
 static bool updatingMultiview = false, mouseSwitching, transitionOnDoubleClick;
 
